# Copy to .env and fill in. Never commit .env.

# Local database started by `npm run db` (embedded PostgreSQL).
DATABASE_URL=postgres://cellar:cellar@localhost:5433/cellar

# Where the web app is served. The API checks the Origin header against this.
APP_ORIGIN=http://localhost:5173

# At least 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Optional in development (a fixed dev-only secret is used), required in production.
SESSION_SECRET=

# Google OAuth client (development client, redirect URI below).
# Leave empty to use the built-in fake sign-in (development only).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/v1/auth/google/callback

# Version of the published terms of use / privacy notice.
TERMS_VERSION=2026-10-01
